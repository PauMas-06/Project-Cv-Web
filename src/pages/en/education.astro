---
import Layout from '../../components/Layout.astro';
---

<Layout title="Education — Pau Mas Sales">
  <div class="max-w-5xl mx-auto py-12 px-4">
    <div class="mb-16 text-center">
      <h1 class="text-5xl font-bold mb-4">My Academic Journey</h1>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        A journey through my education in technology, systems, and cloud computing
      </p>
    </div>

    <div class="relative">
      <div
        class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-accent-primary via-accent-secondary to-accent-primary md:left-1/2"
      >
      </div>

      <div class="space-y-12">
        <div class="relative flex items-start gap-8 md:gap-0">
          <div class="absolute left-8 w-16 h-16 -translate-x-1/2 md:left-1/2 z-10">
            <div
              class="w-full h-full rounded-2xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/30"
            >
              <span class="text-3xl">🎓</span>
            </div>
          </div>
          <div class="ml-24 md:ml-0 md:w-1/2 md:pr-12">
            <div
              class="bg-bg-secondary rounded-2xl border border-border p-6 hover:border-accent-primary/50 transition-colors"
            >
              <div class="flex items-center gap-2 mb-2">
                <span
                  class="px-3 py-1 rounded-full bg-purple-500/20 text-purple-500 text-xs font-medium"
                  >2022 – 2024</span
                >
              </div>
              <h2 class="text-2xl font-bold mb-2">High School — Science & Technology</h2>
              <p class="text-accent-secondary font-medium mb-3">INS Martí Pous</p>
              <p class="text-text-secondary text-sm leading-relaxed">
                Specialized education in sciences, mathematics, and technology that laid the
                foundations for my technical career.
              </p>
            </div>
          </div>
        </div>

        <div class="relative flex items-start gap-8 md:gap-0">
          <div class="absolute left-8 w-16 h-16 -translate-x-1/2 md:left-1/2 z-10">
            <div
              class="w-full h-full rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/30"
            >
              <span class="text-3xl">🖥️</span>
            </div>
          </div>
          <div class="ml-24 md:ml-0 md:w-1/2 md:pl-12 md:ml-auto">
            <div
              class="bg-bg-secondary rounded-2xl border border-border p-6 hover:border-accent-primary/50 transition-colors"
            >
              <div class="flex items-center gap-2 mb-2">
                <span
                  class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-500 text-xs font-medium"
                  >2024 – 2026</span
                >
                <span
                  class="px-3 py-1 rounded-full bg-accent-primary/20 text-accent-primary text-xs font-medium"
                  >GPA: 8.48</span
                >
              </div>
              <h2 class="text-2xl font-bold mb-2">HNC Computer Systems Networking (ASIR)</h2>
              <p class="text-accent-secondary font-medium mb-3">Institut TIC de Barcelona</p>
              <p class="text-text-secondary text-sm leading-relaxed mb-3">
                Linux and Windows system administration, networking, virtualization, databases, web
                development and cybersecurity.
              </p>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Linux</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Windows Server</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Networking</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Virtualization</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="relative flex items-start gap-8 md:gap-0">
          <div class="absolute left-8 w-16 h-16 -translate-x-1/2 md:left-1/2 z-10">
            <div
              class="w-full h-full rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center shadow-lg shadow-cyan-500/30"
            >
              <span class="text-3xl">🏊</span>
            </div>
          </div>
          <div class="ml-24 md:ml-0 md:w-1/2 md:pr-12">
            <div
              class="bg-bg-secondary rounded-2xl border border-border p-6 hover:border-accent-primary/50 transition-colors"
            >
              <div class="flex items-center gap-2 mb-2">
                <span
                  class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-500 text-xs font-medium"
                  >June 2026</span
                >
                <span
                  class="px-3 py-1 rounded-full bg-green-500/20 text-green-500 text-xs font-medium"
                  >✓ Passed</span
                >
              </div>
              <h2 class="text-2xl font-bold mb-2">42 Barcelona — Piscine</h2>
              <p class="text-accent-secondary font-medium mb-3">42 Barcelona</p>
              <p class="text-text-secondary text-sm leading-relaxed mb-3">
                Intensive 26-day C programming bootcamp. Peer-to-peer methodology with no
                instructors, problem-solving under pressure.
              </p>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >C</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Algorithms</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Shell</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Peer-to-peer</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="relative flex items-start gap-8 md:gap-0">
          <div class="absolute left-8 w-16 h-16 -translate-x-1/2 md:left-1/2 z-10">
            <div
              class="w-full h-full rounded-2xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg shadow-green-500/30"
            >
              <span class="text-3xl">☁️</span>
            </div>
          </div>
          <div class="ml-24 md:ml-0 md:w-1/2 md:pl-12 md:ml-auto">
            <div
              class="bg-bg-secondary rounded-2xl border border-border p-6 hover:border-accent-primary/50 transition-colors border-dashed"
            >
              <div class="flex items-center gap-2 mb-2">
                <span
                  class="px-3 py-1 rounded-full bg-green-500/20 text-green-500 text-xs font-medium"
                  >2026 – 2027</span
                >
                <span
                  class="px-3 py-1 rounded-full bg-yellow-500/20 text-yellow-500 text-xs font-medium"
                  >In progress</span
                >
              </div>
              <h2 class="text-2xl font-bold mb-2">Cloud Services Specialization</h2>
              <p class="text-accent-secondary font-medium mb-3">Institut TIC de Barcelona</p>
              <p class="text-text-secondary text-sm leading-relaxed mb-3">
                Specialization course in cloud services. Cloud computing, DevOps, infrastructure as
                code and automation.
              </p>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >AWS</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >DevOps</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Terraform</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Docker</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="relative flex items-start gap-8 md:gap-0">
          <div class="absolute left-8 w-16 h-16 -translate-x-1/2 md:left-1/2 z-10">
            <div
              class="w-full h-full rounded-2xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg shadow-green-500/30"
            >
              <span class="text-3xl">💻</span>
            </div>
          </div>
          <div class="ml-24 md:ml-0 md:w-1/2 md:pr-12">
            <div
              class="bg-bg-secondary rounded-2xl border border-border p-6 hover:border-accent-primary/50 transition-colors border-dashed"
            >
              <div class="flex items-center gap-2 mb-2">
                <span
                  class="px-3 py-1 rounded-full bg-green-500/20 text-green-500 text-xs font-medium"
                  >2026 – ...</span
                >
                <span
                  class="px-3 py-1 rounded-full bg-yellow-500/20 text-yellow-500 text-xs font-medium"
                  >In progress</span
                >
              </div>
              <h2 class="text-2xl font-bold mb-2">42 Barcelona — Cursus</h2>
              <p class="text-accent-secondary font-medium mb-3">42 Barcelona</p>
              <p class="text-text-secondary text-sm leading-relaxed mb-3">
                Main program at 42 Barcelona. Software development, advanced algorithms, operating
                systems, networking and team projects.
              </p>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >C/C++</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Algorithms</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Systems</span
                >
                <span class="px-2 py-0.5 rounded bg-bg-primary/50 border border-border text-xs"
                  >Networking</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
