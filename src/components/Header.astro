---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/cv`, label: t('nav.cv') },
  { href: `/${lang}/projects`, label: t('nav.projects') },
  { href: `/${lang}/education`, label: t('nav.education') },
];

function isActive(href: string): boolean {
  if (href.endsWith('/')) return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-bg-primary/80 backdrop-blur-md"
>
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href={`/${lang}/`} class="text-lg font-semibold hover:text-accent-primary transition-colors">
      Pau Mas Sales
    </a>

    <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'text-accent-primary'
              : 'hover:text-accent-primary',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher />
      <ThemeToggle />

      <button
        id="mobile-menu-btn"
        class="md:hidden rounded-md p-2 hover:bg-bg-secondary transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="block" id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg class="hidden" id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-border bg-bg-primary"
    aria-label="Mobile navigation"
  >
    <div class="container mx-auto px-4 py-4 flex flex-col gap-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium py-2 transition-colors',
            isActive(link.href)
              ? 'text-accent-primary'
              : 'hover:text-accent-primary',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
