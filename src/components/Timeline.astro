---
export interface TimelineEvent {
  date: string;
  title: string;
  subtitle?: string;
  description?: string;
  icon?: string;
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="relative">
  <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-border md:left-4"></div>
  
  {events.map((event) => (
    <div class="relative flex gap-4 pb-8 md:pl-12">
      <div class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-bg-secondary border border-border md:left-0">
        <span class="text-accent-primary">{event.icon || '📍'}</span>
      </div>
      
      <div class="flex-1">
        <div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-2">
          <h3 class="text-lg font-semibold">{event.title}</h3>
          <span class="text-sm text-text-secondary">{event.date}</span>
        </div>
        {event.subtitle && (
          <p class="text-text-secondary mb-2">{event.subtitle}</p>
        )}
        {event.description && (
          <p class="text-sm text-text-secondary">{event.description}</p>
        )}
      </div>
    </div>
  ))}
</div>
