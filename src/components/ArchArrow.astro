---
interface Props {
  label?: string;
  up?: boolean;
}

const { label, up = false } = Astro.props;
---

<div class="relative flex h-8 items-center justify-center" aria-hidden="true">
  <svg
    class:list={['text-text-secondary/70', up && 'rotate-180']}
    width="12"
    height="32"
    viewBox="0 0 12 32"
    fill="none"
  >
    <line
      x1="6"
      y1="1"
      x2="6"
      y2="26"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></line>
    <path
      d="M1.5 23.5L6 29.5L10.5 23.5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {
    label && (
      <span class="absolute left-1/2 ml-3 whitespace-nowrap rounded-md border border-border bg-bg-secondary px-1.5 py-0.5 text-[10px] font-medium text-text-secondary">
        {label}
      </span>
    )
  }
</div>
