---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
}

const detectedLang = getLangFromUrl(Astro.url);
const lang = (Astro.props.lang as string) || detectedLang;
const t = useTranslations(lang as any);
const cvPath = `/cv-${lang}.pdf`;
---

<a
  href={cvPath}
  download
  class="inline-flex items-center gap-2 rounded-xl bg-accent-primary px-6 py-3 text-white font-medium hover:bg-accent-primary/90 transition-colors shadow-lg shadow-accent-primary/20"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
  {t('common.downloadCv')}
</a>
