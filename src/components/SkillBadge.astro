---
interface Props {
  skill: string;
  icon?: string;
}

const { skill, icon } = Astro.props;
---

<span
  class="inline-flex items-center gap-2 rounded-full bg-bg-secondary px-4 py-2 text-sm border border-border hover:border-accent-primary transition-colors"
>
  {icon && <span>{icon}</span>}
  <span>{skill}</span>
</span>
