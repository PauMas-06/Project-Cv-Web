---
import ProjectCard from './ProjectCard.astro';
import { projects, type Locale } from '../data/projects';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const texts = {
  es: {
    title: 'Mis Proyectos',
    intro:
      'Una selección de proyectos personales y académicos donde aplico mis conocimientos en cloud, sistemas y desarrollo.',
  },
  en: {
    title: 'My Projects',
    intro:
      'A selection of personal and academic projects where I apply my knowledge in cloud, systems, and development.',
  },
  ca: {
    title: 'Els Meus Projectes',
    intro:
      'Una selecció de projectes personals i acadèmics on aplico els meus coneixements en cloud, sistemes i desenvolupament.',
  },
};

const sorted = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<div class="mx-auto max-w-7xl px-4 py-12">
  <div class="mb-12">
    <h1 class="mb-4 text-5xl font-bold">{texts[lang].title}</h1>
    <p class="max-w-2xl text-xl text-text-secondary">{texts[lang].intro}</p>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {sorted.map((project) => <ProjectCard project={project} lang={lang} />)}
  </div>
</div>
